rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Every signed-in user can only access their own profile.
      allow read, write: if isOwner(uid);

      // Only collections used by SYNQ are accessible.
      match /{collection}/{document} {
        allow read, write: if isOwner(uid) && collection in [
          'globalTasks',
          'globalEntries',
          'workSessions',
          'sheets',
          'appointments',
          // Legacy collections are accessible so account deletion can remove
          // data created by older versions of the app.
          'habits',
          'entries'
        ];
      }
    }
  }
}
